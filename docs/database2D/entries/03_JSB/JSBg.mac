#-------------------oooooOOOOO00000OOOOOooooo---------------------#

#
# E X P E R I M E N T
#

#/random/setSavingFlag  0
#/random/resetEngineFrom start1.rndm
#/random/setSeeds 1234 5678

/gate/random/setEngineName Ranlux64
/gate/random/setEngineSeed {SEED}

/gate/application/setTimeSlice       5.00  s
/gate/application/setTimeStart       0.00  s
/gate/application/setTimeStop      480.00  s

/gate/application/startDAQ

# /vis/ogl/export   test.pdf

exit

